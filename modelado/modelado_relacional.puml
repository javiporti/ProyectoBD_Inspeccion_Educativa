@startuml modelado_relacional
hide methods
skinparam ClassAttributeIconSize 0


entity "Centros Educativos" as CentrosEducativos {
    IdCentro: int <<PK>>
    --
    Ubicacion
    Prioridad
}

entity Desplazamientos {

}

entity Dietas {

}

entity Citas {

}

entity Anotaciones {

}

entity Visitas {
    *oid_Visita : int <<PK>>
    --
    *Fecha : date
    *HoraInicio : time
    *HoraFin : time
    *EstadoVisita : e_EstadoVisita
    *Responsable : int <<FK>> -> Inspectores
    *Jefe : int <<FK>> -> Inspectores
    *IdCentro : int <<FK>> -> CentrosEducativos
}

entity Informes {
    *oid_Informe : int <<PK>>
    --
    *Prioridad : e_Prioridad
    *Observacion : text
    *oid_Visita : int <<FK>> <<AK>> -> Visitas
}

entity Tareas {
    *oid_Tarea : int <<PK>>
    --
    *Fecha : date
    *HoraInicio : time
    *HoraFin : time
    *Descripcion : text
    *Responsable : int <<FK>> -> Inspectores
    *Jefe : int <<FK>> -> Inspectores
}

entity DiasAsuntosPersonales {

}

entity Zonas {
    Codigo: int <<PK>>
    --
    Nombre
}

entity Personas {
    oid_Persona: <<PK>>
    --
    DNI: <<AK>>
    Nombre
    Apellidos
}

entity Inspectores {
    oid_Persona: <<FK>> <<PK>>
    --
    esJefe
    Codigo: <<FK>> -> Zonas
}
entity Alumnos {
    oid_Persona: <<FK>> <<PK>> -> Persona
    --
    Identificacion: <<FK>> -> CentrosEducativos
}

entity Profesores {
    oid_Persona: <<PK>> <<FK>> -> Persona
    --
    Identificacion: <<FK>> -> CentrosEducativos
}

entity AsignaturasProfesor {
    OID_Persona: <<FK>> <<PK>>
    Asignatura: <<PK>>
    --
}

entity TutoresLegales {
    oid_Persona: <<PK>> <<FK>> -> Personas
    --
}

entity ResponsablesDe {
    oid_RD: <<PK>>
    --
    oid_Persona: <<FK>> -> TutoresLegales, Alumnos
}

entity Tutelas {

}

Inspectores ||--o{ Visitas : realiza (Responsable)
Inspectores ||--o{ Visitas : asigna (Jefe)
Inspectores ||--o{ Tareas : realiza (Responsable)
Inspectores ||--o{ Tareas : asigna (Jefe)
CentrosEducativos ||--o{ Visitas : recibe
Visitas ||--o| Informes : contiene

@enduml

/'
JERARQUÍAS
OP1 : Meter todo en una sola tabla con la superclase y la subclase
OP2 : Sacar la cantidad de tabla según la cantidad de hijos que herenda, y luego en cada tabla la del padre y del propio hijo
OP3 : Una tabla por clase y unir las foreing key de las subclases con la clase padre.
'/