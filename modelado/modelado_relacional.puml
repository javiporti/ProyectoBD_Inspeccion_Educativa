@startuml modelado_conceptual
hide methods
skinparam ClassAttributeIconSize 0


entity "Centros Educativos" as CentrosEducativos {
    Identificacion: int <<PK>>
    --
    Ubicacion
    Prioridad
    Zona: int <<FK>> -> Zonas
    ProfesorResponsable: int <<FK>> <<AK>> [0..1] -> Profesores
}


entity DocumentosCita {
    Num_solicitud: int <<PK>> <<FK>> -> Citas
    DocumentacionAdjunta : string <<PK>>
    --
     
}
entity Citas {
    Num_solicitud: int <<PK>> 
    --
    Fecha [0..1]
    Hora [0..1]
    Titulo
    TextoSolicitud
    Estado: e_EstadoCita
    Prioridad: e_Prioridad [0..1]
    Procedencia: e_Procedencia
    Tutor: int <<FK>> -> TutoresLegales
    Alumno: int <<FK>> -> Alumnos
    Inspector: int <<FK>> [0..1] -> Inspectores

}

entity Anotaciones {
    oid_Anotacion: int <<PK>>
    --
    Fecha
    Titulo
    Descripcion
    Prioridad: e_Prioridad
    Inspector: int <<FK>> -> Inspectores
    Centro: int <<FK>> -> CentrosEducativos
}



entity Visita {
    oid_Visita: int <<PK>>
    --
    Fecha
    HoraInicio
    HoraFin

    EstadoVisita


}

entity Informe {

}

entity Tarea {
    oid_Tarea: int <<PK>>
    --
    Fecha
    HoraInicio
    HoraFin

    Descripcion
}



entity Zonas {
    Codigo: int <<PK>>
    --
    Nombre: string <<AK>>
    
}

entity Persona {
    oid_Persona: <<PK>>
    --
    DNI: <<AK>>
    Nombre
    Apellidos
}

entity inspector {
    oid_Persona: <<PK>> <<FK>> -> Persona
    --
    esJefe
    Codigo: <<FK>> -> Zona
}

entity Alumno {
    oid_Persona: <<PK>> <<FK>> -> Persona
    --
    Identificacion: <<FK>> -> CentroEducativo
}

entity Profesor {
    oid_Persona: <<PK>> <<FK>> -> Persona
    --
    Identificacion: <<FK>> -> CentroEducativo
}

entity AsignaturaProfesor {
    oid_Persona: <<FK>> <<PK>>
    Asignatura: <<PK>>
    --
}

entity TutorLegal {
    oid_Persona: <<PK>> <<FK>> -> Persona
    --
}

entity ResponsableDe {
    oid_RD: <<PK>>
    --
    oid_Persona: <<FK>> -> TutorLegal, Alumno
}

entity Tutela {

}

entity Desplazamientos {
    oid_Visita: int <<PK>> <<FK>> -> Visitas
    --
    Origen: string
    Destino: string
    HoraSalida
    HoraLlegadaDomicilio [0..1]
    Kilometros: int
    TarifaK: float
}
entity Dietas {
    oid_Visita: int <<PK>> <<FK>> -> Desplazamientos
    --
    Importe: int
    Almuerzo: bool
}
Desplazamientos |o--||Visitas
Dietas |o--||Desplazamientos

entity DiasAsuntosPersonales {
    oid_DAP: int <<PK>>
    --
    inspector: int <<FK>> <<AK1>> -> Inspectores
    Curso: int <<AK1>>
    DiasSolicitados
    
    
}

entity Cursos {
    curso: string <<PK>>
    --
    inspector: int <<FK>> -> Inspectores
    DiasTotales

}

DiasAsuntosPersonales }o--||Cursos
DiasAsuntosPersonales }o--||Inspectores

'------- ASOCIACIONES --------------------------------------
DocumentosCita }o--|| Citas

@enduml


/'
JERARQUÍAS
OP1 : Meter todo en una sola tabla con la superclase y la subclase
OP2 : Sacar la cantidad de tabla según la cantidad de hijos que herenda, y luego en cada tabla la del padre y del propio hijo
OP3 : Una tabla por clase y unir las foreing key de las subclases con la clase padre.
'/
